<?xml version="1.0" encoding="utf-8"?>
<!--
    Production / shared baseline for ALL flavors and build types.

    Policy: cleartext traffic is DENIED by the OS for every domain.
    Exceptions for development hosts live ONLY in
    `src/debug/res/xml/network_security_config.xml`, which the Android
    manifest merger applies exclusively to debug builds.

    targetSdk = 36, so the effective network policy comes from THIS file
    when referenced via `android:networkSecurityConfig`. The legacy
    `android:usesCleartextTraffic` attribute on <application> is ignored
    by the OS at this targetSdk when networkSecurityConfig is set.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
