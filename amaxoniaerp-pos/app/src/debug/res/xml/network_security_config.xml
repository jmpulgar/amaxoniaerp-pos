<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only policy. Overrides src/main/res/xml/network_security_config.xml
    in debug builds via Android manifest merger (debug source set wins).
    Opens cleartext QUIRURGICALLY for known dev hosts only. Release builds
    inherit the main policy which has no exceptions.

    Hosts covered:
      - 192.168.2.10  primary dev backend (BASE_URL in build.gradle.kts debug)
      - 192.168.2.16  legacy alias
      - 10.0.2.2      Android emulator → host loopback
      - localhost     local services on the device
      - 127.0.0.1     explicit loopback
    To add a new dev host: edit ONLY this file. Never weaken src/main.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.2.10</domain>
        <domain includeSubdomains="false">192.168.2.16</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
